comment20.target=int\ getEnergy()
comment21.params=
comment21.target=int\ getKnowledge()
comment22.params=
comment22.target=int\ getDefense()
comment23.params=
comment23.target=boolean\ wasLastActionCritical()
comment3.params=amount
comment3.target=void\ heal(int)
comment3.text=\r\n\ Recupera\ vida\ (ex.\:\ tomar\ um\ caf\u00E9,\ dormir\ bem).\r\n
comment4.params=
comment4.target=boolean\ isDefeated()
comment4.text=\r\n\ Diz\ se\ o\ estudante\ ainda\ pode\ lutar.\r\n
comment5.params=amount
comment5.target=boolean\ spendEnergy(int)
comment5.text=\r\n\ Tenta\ gastar\ energia.\r\n\ Se\ tiver\ energia\ suficiente,\ gasta\ e\ devolve\ true.\r\n\ Se\ n\u00E3o\ tiver,\ n\u00E3o\ gasta\ nada\ e\ devolve\ false.\r\n
comment6.params=amount
comment6.target=void\ recoverEnergy(int)
comment6.text=\r\n\ Recupera\ energia\ (ex.\:\ descansar\ um\ turno).\r\n
comment7.params=amount
comment7.target=void\ loseEnergy(int)
comment7.text=\r\n\ Perde\ energia\ por\ causa\ de\ um\ ataque\ inimigo\ (ex.\:\ Infinite\ Loop).\r\n\ Diferente\ de\ spendEnergy\:\ aqui\ n\u00E3o\ \u00E9\ uma\ escolha,\ ent\u00E3o\ sempre\ acontece.\r\n
comment8.params=amount
comment8.target=void\ increaseKnowledge(int)
comment8.text=\r\n\ Aumenta\ o\ conhecimento\ (ex.\:\ ao\ estudar\ ou\ vencer\ uma\ disciplina).\r\n
comment9.params=action
comment9.target=boolean\ canPerform(PlayerAction)
comment9.text=\r\n\ O\ estudante\ tem\ energia\ suficiente\ para\ esta\ a\u00E7\u00E3o?\r\n
